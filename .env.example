# copy to .env and fill in. Never commit .env
LLM_PROVIDER=groq            # groq | gemini | openai | mock
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b  # optional: override the default model
# LLM_MIN_SECONDS_BETWEEN_CALLS=4
# LLM_REASONING_EFFORT=low     # optional: low | medium | high, only used by Groq gpt-oss models
# LLM_INCLUDE_CAMERA=false     # optional: true also sends CAMERA lines to the AI (more tokens)
# SHOW_TITLE=My Show Title       # optional: show title for cross-episode and posting-order calls (default: input folder name)
